{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scrollverse.co/schemas/federation-event.v1.json",
  "title": "ScrollVerse Federated Event Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "occurred_at",
    "producer",
    "subject",
    "correlation_id",
    "classification",
    "payload",
    "provenance",
    "policy"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{1,99}$"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "service"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "service": {
          "type": "string",
          "minLength": 1
        },
        "specialist_profile": {
          "type": "string"
        }
      }
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "causation_id": {
      "type": "string",
      "format": "uuid"
    },
    "classification": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "RESTRICTED"
      ]
    },
    "payload": {
      "type": "object"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ref"
      ],
      "properties": {
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{40}$"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "permitted_actions"
      ],
      "properties": {
        "permitted_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "read",
              "index",
              "propose_change"
            ]
          }
        },
        "retention_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        }
      }
    }
  }
}
